<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ClockInTray.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release: one exe in dist\ (needs the .NET 10 Desktop Runtime). Builds stay in bin\Release\net10.0-windows. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\dist\</PublishDir>
  </PropertyGroup>

  <!-- Version resource: Company is shown as the Publisher in Task Manager > Startup apps. -->
  <PropertyGroup>
    <Company>N2K02</Company>
    <Authors>N2K02</Authors>
    <Product>ClockInTray</Product>
    <AssemblyTitle>ClockInTray</AssemblyTitle>
    <Description>Tray clock-in tracker showing the time left in the work day.</Description>
    <Copyright>Copyright © N2K02 2026</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>